{
  "identifier": "default",
  "description": "Default capabilities for ScribeBuddy",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-save",
    "shell:default"
  ]
}
